{
  // TypeScript is served by the `tsgo` extension (install it from Zed's
  // extension list — https://zed.dev/extensions/tsgo). vtsls and Zed's default
  // tsserver stay off: TypeScript 7 ships no lib/tsserver.js (its only bin is
  // `tsc`, shelling out to the native Go binary), so both silently fall back to
  // their own bundled TypeScript, which cannot resolve the "#/..." subpath
  // imports — TS2307 all over the editor while `pnpm --filter web typecheck` is
  // clean. Verified: TS 5.9 reports 124 of those on this repo, TS 7.0.2 none.
  // NOTE: `language_servers` only takes effect *inside* a `languages` block —
  // a top-level one is ignored, which is why "!vtsls" here never disabled it.
  // The real selection lives under languages.{JavaScript,TypeScript,TSX} —
  // Zed has no separate "JSX" language (JavaScript covers .jsx), even though
  // the tsgo extension lists one.
  "lsp": {
    "typescript-ls": {
      "settings": {
        // The extension otherwise fetches the *latest* typescript package,
        // which would type-check the editor against a different compiler than
        // the CLI does. Keep this in lockstep with the `typescript` entry in
        // pnpm-workspace.yaml's default catalog — bump both together.
        "package_version": "7.0.2"
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix",
          "typeAware": true,
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "configPath": "./vite.config.ts",
          "run": "onSave"
        }
      }
    }
  },
  "languages": {
    "CSS": {
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."],
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "HTML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JavaScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!eslint", "..."],
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TypeScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!eslint", "..."],
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!eslint", "..."],
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  }
}
