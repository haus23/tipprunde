{
  "name": "tipprunde",
  "version": "1.12.1",
  "description": "Haus23 Tipprunde",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "oxfmt --check . && oxlint .",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "prepare": "[ -z \"$CI\" ] && simple-git-hooks || true"
  },
  "devDependencies": {
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.14.0",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,css}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@12.2.1"
}
