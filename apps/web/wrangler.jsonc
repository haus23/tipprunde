{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tipprunde-manager",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./dist/client",
  },
  // Values live in the dashboard (or .env locally) — declaring them here makes
  // `wrangler deploy` fail loudly when one is missing, instead of the Worker
  // throwing at runtime.
  "secrets": {
    "required": [
      "APP_SECRET",
      "RESEND_API_KEY",
      "SESSION_SECRET",
      "TURSO_AUTH_TOKEN",
      "TURSO_DATABASE_URL",
    ],
  },
  "vars": {
    "TOTP_EXPIRES_IN": "600",
    "TOTP_MAX_ATTEMPTS": "3",
    "SESSION_DURATION_DEFAULT": "86400",
    "SESSION_DURATION_REMEMBER": "2592000",
    "FROM_EMAIL": "hallo@runde.tips",
  },
}
